PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/exam_management?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_string_for_jwt_auth_production

# AI Inference Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
