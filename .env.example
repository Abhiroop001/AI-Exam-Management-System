# =========================================================================
# BACKEND ENVIRONMENT VARIABLES (Configured on Render.com Web Service)
# =========================================================================
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/exam_management?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_string_for_jwt_auth_production

# AI Inference Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
HUGGINGFACE_API_KEY=hf_your_huggingface_read_token_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Client URLs (Set to your Vercel deployment URLs in production)
CLIENT_TEACHER_URL=https://your-teacher-portal.vercel.app
CLIENT_STUDENT_URL=https://your-student-portal.vercel.app


